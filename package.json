{
  "name": "renaiss-slab-king",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Renaiss Slab King — 사천성 방식 카드 매칭 퍼즐 (Renaiss OS Index + 공식 Renaiss CLI 연동)",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --static",
    "preview": "vite preview",
    "test": "tsx scripts/test-shisen.ts && tsx scripts/test-board.ts && tsx scripts/test-modes.ts && tsx scripts/test-sim.ts && tsx scripts/test-server.ts",
    "prefetch": "npm run prefetch:pool && npm run prefetch:cli",
    "prefetch:pool": "node scripts/prefetch-pool.mjs",
    "prefetch:cli": "node scripts/prefetch-cli.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "concurrently": "^10.0.3",
    "fastify": "^5.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
